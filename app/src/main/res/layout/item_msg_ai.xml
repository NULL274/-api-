<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="5dp">

    <LinearLayout
        android:id="@+id/thinkingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_thinking"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/thinkingHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/thinkingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_thinking"
                android:textColor="#8D6E63"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/thinkingArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="▾"
                android:textColor="#8D6E63"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/thinkingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#E0C9A6" />

            <TextView
                android:id="@+id/thinkingText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:alpha="0.85"
                android:lineSpacingExtra="2dp"
                android:textColor="#7A6A5A"
                android:textIsSelectable="true"
                android:textSize="13sp"
                tools:text="用户问的是…先回想一下…" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/messageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_ai"
        android:elevation="1dp"
        android:lineSpacingExtra="3dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:textColor="#202124"
        android:textIsSelectable="true"
        android:textSize="15sp"
        tools:text="你好，有什么可以帮你？" />

    <TextView
        android:id="@+id/metaText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="3dp"
        android:textColor="#9AA0A6"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="12.3 tok/s"
        tools:visibility="visible" />
</LinearLayout>
